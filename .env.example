# Database
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/my_crm?schema=public"

# Session signing key — generate with: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-nilai-acak-minimal-32-karakter"

# Public URL, dipakai di tautan reset password dan footer email
APP_URL="http://localhost:3000"

# Zona waktu perusahaan. Semua batas "hari ini" (jatuh tempo, pengingat, aging)
# dihitung di zona ini, bukan zona server.
APP_TIMEZONE="Asia/Jakarta"

# Email (Resend). Tanpa ini, email dicatat sebagai SKIPPED dan aplikasi tetap jalan.
RESEND_API_KEY=""
EMAIL_FROM="invoice@domain-anda.com"

# Payment link (Midtrans Snap). Kosongkan kalau belum dipakai.
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Secret untuk endpoint cron (/api/cron/*)
CRON_SECRET="ganti-dengan-nilai-acak"

# Opsional: kirim error terstruktur ke Sentry, Slack, atau endpoint JSON lain
ERROR_WEBHOOK_URL=""

# Opsional: lokasi backup dan berapa file yang disimpan
BACKUP_DIR="backups"
BACKUP_KEEP="14"
# Isi kalau pg_dump/pg_restore tidak ada di PATH
PG_DUMP_PATH=""
PG_RESTORE_PATH=""
